# LLM Provider Configuration (Dual-Key & Tiered Model Architecture)
GEMINI_API_KEY_PRIMARY=
GEMINI_MODEL_PRIMARY=gemini-1.5-flash
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL_SECONDARY=gemini-2.0-flash

# Fallback / Single-Key Legacy Compatibility
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini
LLM_CALL_BUDGET=30

# Threat Intelligence APIs (Optional free NVD key raises limit from 5 to 50 req/30s)
NVD_API_KEY=

# OWASP ZAP Daemon Configuration
ZAP_API_KEY=
ZAP_URL=http://localhost:8080

# Local Storage Paths
DB_PATH=local_data/cipher_lens.db
RAW_DIR=local_data/artifacts

# Operational Flags
OFFLINE_MODE=false
