# LLM Provider Configuration (Single-Project Gemini with Retry)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
LLM_CALL_BUDGET=30
LLM_MAX_OUTPUT_TOKENS=2048

# Threat Intelligence APIs (Optional free NVD key raises limit from 5 to 50 req/30s)
NVD_API_KEY=

# OWASP ZAP Daemon Configuration
ZAP_API_KEY=
ZAP_URL=http://localhost:8080

# Local Storage and Cryptography (FERNET_KEY enables opt-in data-at-rest encryption)
DB_PATH=local_data/cipher_lens.db
RAW_DIR=local_data/artifacts
FERNET_KEY=

# Operational & Safety Flags
OFFLINE_MODE=false
ENABLE_CHAOS=false
ALLOW_SELF_APPROVAL=false

# Authentication Tokens (Streamlit UI Role-Based Access Control)
ADMIN_TOKEN=
OPERATOR_TOKEN=
AUDITOR_TOKEN=
